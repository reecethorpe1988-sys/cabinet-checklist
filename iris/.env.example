# ── Claude ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Instagram ───────────────────────────────────────────
# mock = simulated Instagram account (nothing is posted)
# live = your real Instagram professional account
IG_MODE=mock
# Long-lived Instagram User access token (see README → "Connecting Instagram").
# Iris refreshes it automatically before it expires, and stores the newest one in data/ig-token.json.
IG_ACCESS_TOKEN=
# Optional: your Instagram professional account ID (looked up automatically if blank)
IG_USER_ID=
IG_API_VERSION=v25.0

# ── Photo hosting (for photos you drop in photos/) ──────
# Instagram can only post images that are on a public URL. Iris uploads your
# local photos to Cloudinary and converts them to JPEG. Format:
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME   (Cloudinary dashboard → API Keys)
CLOUDINARY_URL=

# ── Where Claudius lives (Iris reads its catalog and recent sales) ──
CLAUDIUS_DIR=../claudius

# ── Schedule ────────────────────────────────────────────
# `npm run daemon`: plans new posts every IRIS_PLAN_HOURS and publishes due posts every 15 minutes
IRIS_PLAN_HOURS=24
IRIS_PAUSED=0
