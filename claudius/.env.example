# ── Claude ──────────────────────────────────────────────
# Get a key at https://platform.claude.com (or run `ant auth login` and leave this blank)
ANTHROPIC_API_KEY=

# ── eBay ────────────────────────────────────────────────
# mock       = runs against a simulated copy of your store (no keys needed, nothing real changes)
# sandbox    = eBay's test environment (sandbox keys)
# production = your real store. Claudius acts on its own here.
EBAY_MODE=mock

# From https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Long-lived user refresh token for your seller account (see README → "Getting a refresh token")
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_AU

# ── Schedule ────────────────────────────────────────────
# How often `npm run daemon` runs a full cycle
CLAUDIUS_INTERVAL_HOURS=6
# Set to 1 to pause all actions (same effect as creating a file named STOP)
CLAUDIUS_PAUSED=0
